# deploy-apprun.sh の設定。ai-gateway/.env にコピーして値を入れる（.env は git に含めない）

# コンテナレジストリ（さくらのクラウド）
REGISTRY=example.sakuracr.jp
REGISTRY_USER=
REGISTRY_PASSWORD=

# さくらのクラウドの API キー（AppRun の操作に使う）
SAKURA_ACCESS_TOKEN=
SAKURA_ACCESS_TOKEN_SECRET=

# 以下は省略可（値は既定値）
# APP_NAME=konnect-ai-gateway
# MIN_SCALE=1
# MAX_SCALE=1
# MAX_CPU=1
# MAX_MEMORY=2Gi
# TIMEOUT_SECONDS=300
